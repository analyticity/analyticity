# Data stack (docker-compose.data.yml). Copy to .env on the server (analyticity-data/) or to
# .env.data.local for a local run. Never commit the filled-in file; back it up encrypted (docs env-backup).
REGISTRY=dexter.fit.vutbr.cz/analyticity
IMAGE_TAG=2026-11-08

POSTGRES_DB=traffic
POSTGRES_USER=admin
# new password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Waze for Cities partner feed and NDIC push credentials: same as the old stack
WAZE_URL=
NDIC_USER=
NDIC_PASS=

POLICE_REGION=JHM
POLICE_START_YEAR=2016

# Brno
BBOX_MIN_LON=16.43
BBOX_MIN_LAT=49.11
BBOX_MAX_LON=16.79
BBOX_MAX_LAT=49.30

LINKER_INTERVAL=2m
