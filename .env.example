# ════════════════════════════════════════════════════════════════════════════
#  dexter.fit.vutbr.cz deploy (docker-compose.prod.yml) — https://dexter.fit.vutbr.cz/analyticity/brno/
#  Copy to .env and fill in. .env is gitignored — never commit it; back it up only
#  encrypted (docs repo, env-backup).
#
#  POSTGRES_*_BRNO must match the `traffic` data stack running on the server
#  (/home/lazy_lemour/magda/infrastructure/compose/dev/.env); this project reaches
#  it over the external `infrastructure-network`.
# ════════════════════════════════════════════════════════════════════════════

# ── Images (dexter registry, pushed from docker-compose.build.yml) ───────────
REGISTRY=dexter.fit.vutbr.cz/analyticity
IMAGE_TAG=latest

# ── API keys (X-API-Key header) ──────────────────────────────────────────────
# Allowed keys, comma-separated, one per client (web, each student, ...) so one can be revoked alone.
# Generate: openssl rand -hex 32. Without API_KEYS the API refuses every data request (503).
API_KEYS=
# Key the web sends — must be one of API_KEYS. It is visible in the browser.
WEB_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
ORIGINS=https://dexter.fit.vutbr.cz

# ── City DB (Brno — postgres-timescale of the `traffic` stack) ───────────────
POSTGRES_HOST_BRNO=postgres-timescale
POSTGRES_PORT_BRNO=5432
POSTGRES_DB_BRNO=
POSTGRES_USER_BRNO=
POSTGRES_PASSWORD_BRNO=

# ── Central DB (container db-central of this project) ─────────────────────────
# Used both to create the DB on its first start and by the api to connect.
DB_CENTRAL_NAME=central_db
DB_CENTRAL_USER=
DB_CENTRAL_PASSWORD=                # generate: openssl rand -hex 24

# ── Admin login (JWT cookie) ─────────────────────────────────────────────────
SECRET_KEY=                         # generate: openssl rand -hex 64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Risky road sections (hidden from the menu for now) ───────────────────────
DBSCAN_EPS_METERS=100.0
DBSCAN_MIN_SAMPLES=3
AUTO_CLUSTER_ON_STARTUP=false

# ── Contact form e-mail ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.seznam.cz
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_RECIPIENT=

# ── App ──────────────────────────────────────────────────────────────────────
# City name shown in the web; also the town whose admin users may log in
VITE_APP_CITY=Brno
VITE_APP_CENTER_LON=16.6
VITE_APP_CENTER_LAT=49.2
WORKERS=1
