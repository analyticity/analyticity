# ════════════════════════════════════════════════════════════════════════════
#  dexter.fit.vutbr.cz deploy — Brno app services (docker-compose.prod.yml)
#  Copy to .env and fill in. .env is gitignored — never commit.
#
#  Values for POSTGRES_*_BRNO / KAFKA_BROKERS / topics MUST match the already
#  running `traffic` data stack on the server
#  (/home/lazy_lemour/magda/infrastructure/compose/dev/.env) — this project
#  connects to it over the external `infrastructure-network`, it does not start
#  its own postgres-timescale/redpanda.
# ════════════════════════════════════════════════════════════════════════════

# ── Registry / image tag ─────────────────────────────────────────────────────
REGISTRY=ghcr.io/analyticity
IMAGE_TAG=latest

# ── CORS ──────────────────────────────────────────────────────────────────────
ORIGINS=https://dexter.fit.vutbr.cz

# ── City-local DB  (Brno — postgres-timescale on infrastructure-network) ──────
POSTGRES_HOST_BRNO=postgres-timescale
POSTGRES_PORT_BRNO=5432
POSTGRES_DB_BRNO=
POSTGRES_USER_BRNO=
POSTGRES_PASSWORD_BRNO=

# ── TrafficJamsBackend ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://REPLACE:REPLACE@postgres-timescale:5432/REPLACE
DATABASE_URL_SYNC=postgresql+psycopg2://REPLACE:REPLACE@postgres-timescale:5432/REPLACE
DATA_SOURCE=postgres
DBSCAN_EPS_METERS=100.0
DBSCAN_MIN_SAMPLES=3
AUTO_CLUSTER_ON_STARTUP=false
MODELS_DIR=models
WORKERS=1

# ── AdminBackend  (JWT) ───────────────────────────────────────────────────────
SECRET_KEY=                         # generate: openssl rand -hex 64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (AdminBackend) ────────────────────────────────────────────────────
EMAIL_HOST=smtp.seznam.cz
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_RECIPIENT=

# ── Central DB  (shared across cities — PENDING, not yet deployed on
#    dexter.fit.vutbr.cz; see CLAUDE.md open item before relying on these) ────
DB_CENTRAL_HOST=db_central
DB_CENTRAL_PORT=5432
DB_CENTRAL_NAME=central_db
DB_CENTRAL_USER=db
DB_CENTRAL_PASSWORD=

# ── UI  (baked defaults live in docker-compose.prod.yml; override here if needed) ──
VITE_API_BASE_URL=/analyticity/brno/api
VITE_API_BACKEND_URL=/analyticity/brno/admin
VITE_APP_CENTER_LON=16.6
VITE_APP_CENTER_LAT=49.2
VITE_APP_CITY=Brno
